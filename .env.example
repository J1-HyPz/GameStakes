# ============================================================================
# GameStakes configuration
# Copy to .env (repo root) and edit. Every variable has a sane default — the
# app starts with zero configuration (SQLite, no Redis, no provider keys) and
# tells you in the UI which features are unavailable.
#
# How it is read:
#  - Local dev: the backend loads ./.env automatically.
#  - Docker: both compose files forward the repo-root .env into the container
#    (env_file), EXCEPT stack wiring (DATABASE_URL, REDIS_URL, PORT) which the
#    compose files pin. POSTGRES_PASSWORD is the one compose-interpolation
#    variable: set it in your shell (or docker/.env) before the FIRST `up`.
# ============================================================================

# ---- Core --------------------------------------------------------------------
# Port the web UI and API listen on (single port for both).
PORT=8080

# Serve the app under a subpath behind a reverse proxy, e.g. ROOT_PATH=/gamestakes
ROOT_PATH=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# IANA timezone used for schedule displays and job scheduling.
TIMEZONE=Europe/London

# Display currency for bankroll and stakes (ISO 4217).
CURRENCY=GBP

# ---- Database ----------------------------------------------------------------
# Default is SQLite in ./data (slim mode). For the full stack use PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://gamestakes:gamestakes@db:5432/gamestakes
DATABASE_URL=sqlite+aiosqlite:///./data/gamestakes.db

# PostgreSQL password for the full docker-compose stack. Read by compose
# interpolation (shell env or docker/.env — NOT this file), and captured by the
# database volume on first initialisation, so set it before the first `up`.
# POSTGRES_PASSWORD=change-me

# ---- Cache / broker ----------------------------------------------------------
# Optional. Leave empty to run without Redis (in-process caching, slim mode).
#   REDIS_URL=redis://redis:6379/0
REDIS_URL=

# ---- Auth --------------------------------------------------------------------
# Optional single-user login for non-LAN deployments. Off by default.
AUTH_ENABLED=false
# Password for the single user when AUTH_ENABLED=true.
AUTH_PASSWORD=
# Secret for signing JWT sessions. Generate one: openssl rand -hex 32
JWT_SECRET=

# ---- Container ---------------------------------------------------------------
# UID/GID the app runs as inside the container (match your dataset owner on
# TrueNAS). Only read by the container entrypoint.
PUID=1000
PGID=1000

# ---- Data providers (all optional; added from Phase 3 onward) ----------------
# Each provider unlocks specific sports/leagues. Test keys live on the
# Settings > Data Sources page. Links to obtain keys:
#
# API-Sports (football, basketball, NFL, MMA)  https://dashboard.api-football.com
API_SPORTS_KEY=
# The Odds API (bookmaker odds; required for the bet builder)  https://the-odds-api.com
THE_ODDS_API_KEY=
# Odds region passed to The Odds API: uk, eu, us, au
ODDS_REGION=uk
# football-data.org (free European football fixtures/results)  https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_KEY=
# TheSportsDB (multi-sport metadata, logos)  https://www.thesportsdb.com/api.php
THESPORTSDB_KEY=
# balldontlie (NBA)  https://www.balldontlie.io
BALLDONTLIE_KEY=
